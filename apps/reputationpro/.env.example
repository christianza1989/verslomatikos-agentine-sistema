APP_URL=http://127.0.0.1:3000
# Compatibility alias requested by TASK-002; server-generated links use APP_URL.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
DATABASE_PATH=./data/reputation.db
# Local MVP only. Production must set false and use HTTPS.
DEMO_MODE=true
ADMIN_EMAIL=owner@reputationpro.local
# Set a strong private password in .env.local; never commit it.
ADMIN_PASSWORD=
SESSION_SECRET=
# Stripe sandbox restricted key with Checkout + subscriptions permissions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional existing recurring EUR 49 price. Otherwise inline 4900 cents/month is used.
STRIPE_PRICE_ID=
